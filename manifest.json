{
  "manifest_version": 3,
  "name": "NevUp AI",
  "version": "1.0",
  "description": "AI trading psychology analyzer + nudges + points.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NevUp"
  },
  "content_scripts": [
    {
      "matches": ["*://*.binance.com/*", "*://binance.com/*"],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ]
}
